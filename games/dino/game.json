{
  "name": "dino",
  "title": "Chrome Dino",
  "original": {
    "repo": "wayou/t-rex-runner",
    "note": "Chromium's t-rex runner, extracted by @liuwayong",
    "license": "BSD-3-Clause",
    "path": "originals/dino"
  },
  "record": "record.mjs",
  "ports": {
    "web": {
      "cmd": [
        "node",
        "ports/web/run.mjs"
      ],
      "play": "ports/web/index.html"
    },
    "godot": {
      "cmd": [
        "godot",
        "--headless",
        "--path",
        "ports/godot",
        "--script",
        "runner.gd"
      ]
    },
    "bevy": {
      "build": [
        "cargo",
        "build",
        "--release",
        "--quiet",
        "--manifest-path",
        "ports/bevy/Cargo.toml",
        "-p",
        "dino-runner"
      ],
      "cmd": [
        "ports/bevy/target/release/dino-runner"
      ]
    }
  }
}
