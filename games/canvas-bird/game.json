{
  "name": "canvas-bird",
  "title": "Canvas Bird",
  "original": {
    "repo": "giotiskl/Canvas-Bird",
    "license": "MIT",
    "path": "originals/canvas-bird"
  },
  "record": "record.mjs",
  "ports": {
    "web": {
      "cmd": [
        "node",
        "ports/web/run.mjs"
      ],
      "play": "ports/web/index.html"
    },
    "godot": {
      "cmd": [
        "godot",
        "--headless",
        "--path",
        "ports/godot",
        "--script",
        "runner.gd"
      ]
    },
    "bevy": {
      "build": [
        "cargo",
        "build",
        "--release",
        "--quiet",
        "--manifest-path",
        "ports/bevy/Cargo.toml",
        "-p",
        "bird-runner"
      ],
      "cmd": [
        "ports/bevy/target/release/bird-runner"
      ]
    }
  }
}
